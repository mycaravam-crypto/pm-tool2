# Copy to .env in this same directory (next to docker-compose.yml) and fill
# in as needed — `docker compose up` reads it automatically for variable
# substitution. Everything here is optional; see docker-compose.yml for the
# default each one falls back to when unset.
#
# (This is the Docker/production-deployment counterpart to
# server/.env.example, which is for running the server directly with `npm
# run dev`/`npm run start` outside a container.)

# --- Core ---
# Real origin this is served from. Used to build password-reset email links
# and as the allowed CORS origin (server/index.js) — get this wrong in
# production and either resets link to the wrong place, or the app rejects
# its own client's requests.
CLIENT_ORIGIN=http://localhost:3001

# --- Email (server/utils/mailer.js) ---
# If SMTP_HOST is unset, emails are logged to the container's console instead
# of sent — no credentials needed for a demo/trial deployment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ChronosPM <no-reply@chronospm.local>"

# --- Digest cron schedules (server/cron.js), standard 5-field cron syntax ---
CRON_SCHEDULE="0 7 * * *"
STATUS_REPORT_CRON_SCHEDULE="0 8 * * 1"

# --- First-run demo data ---
# When "true", docker-entrypoint.sh seeds demo projects/stakeholders/logins
# the first time the app starts against an empty database volume. Never
# touches an existing database. Leave false for a real deployment.
SEED_DEMO_DATA=false
